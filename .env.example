# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# VITE_SUPABASE_URL & VITE_SUPABASE_ANON_KEY:
# Optional client-side Supabase configuration when connecting to an external Supabase PostgreSQL instance.
# Never expose SUPABASE_SERVICE_ROLE_KEY in VITE_ variables or client-side code.
VITE_SUPABASE_URL="https://pikgvqzvainywbfdlusv.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# VITE_STUDIO_ADMIN_EMAIL:
# Primary bootstrapped Super Admin email address for AVENIQ Command Centre.
VITE_STUDIO_ADMIN_EMAIL="abhighodke5123@gmail.com"
